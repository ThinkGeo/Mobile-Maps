<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:samples="clr-namespace:HowDoISampleGpu.Samples"
       x:Class="HowDoISampleGpu.AppShell"
       FlyoutBehavior="Disabled">

    <!-- A bare ShellContent under Shell leaves its page unmeasured - it reports
         MAUI's 320x480 fallback forever, and a map sized from that draws the wrong
         extent into a stretched surface. Wrapping it in a TabBar is what gives the
         content host a real size; the working classic gallery does the same. -->
    <TabBar>
        <ShellContent Title="First Light"
                      ContentTemplate="{DataTemplate samples:FirstLight}"
                      Route="FirstLight" />
    </TabBar>
</Shell>
