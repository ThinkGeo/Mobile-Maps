<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The GPU gallery for MAUI: the counterpart of samples/wpf/HowDoISample, whose
    every sample draws through GpuBasemap. It sits beside HowDoISample rather than
    replacing it, exactly as the WPF repository keeps HowDoISample.Classic beside
    the GPU one - the two galleries answer different questions and a customer on
    the classic renderer still needs theirs.

    Unlike HowDoISample this project builds against the SDK *sources*, not the
    published packages: the MAUI GPU surface is newer than any package, so a
    ProjectReference is the only way to run it. Switch to PackageReferences once
    ThinkGeo.UI.Maui ships its GPU API.
  -->

  <PropertyGroup>
    <TargetFrameworks>net10.0-ios;net10.0-android36.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>HowDoISampleGpu</RootNamespace>

    <ApplicationTitle>ThinkGeo Maps</ApplicationTitle>
    <!--
      Per platform, because MAUI's single project feeds ApplicationId to two different
      things: CFBundleIdentifier on iOS and the package name on Android. One value for
      both would have named the Android build after iOS.

      iOS takes the id of ThinkGeo Maps, which is already on the App Store
      (id 1559817900) and whose current version is the Xamarin gallery this one
      succeeds, so a build goes to that listing as an update rather than opening a
      second one beside it: the name, the store URL and the ratings carry over, and
      the name is not available to a new record anyway, an account being unable to
      reuse a name it already uses. The id travels this way round because a record's
      bundle id is fixed once it has a build - the app takes the record's id, never
      the reverse.

      Android takes the id ITS store already knows, for the same reason and by the
      same rule, which is also why the two ids are named after their platforms rather
      than after the framework they share. ThinkGeo's Android sample was published as
      com.thinkgeo.androidhowdoi; that listing 404s today, so there is nothing to
      update yet, but if it is merely unpublished rather than deleted then this is
      already the id that slots back into it. Only if Play has retired the name - a
      deleted app's package name can never be used again - does this line have to
      change.

      The ThinkGeo licence is validated against the id on both platforms, so the
      licence that keeps the watermark off a device build has to be issued for the id
      that platform actually uses.
    -->
    <ApplicationId Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">com.thinkgeo.ioshowdoi</ApplicationId>
    <ApplicationId Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">com.thinkgeo.androidhowdoi</ApplicationId>
    <ApplicationIdGuid>0d4f4f3e-7b64-4a0e-9d07-2d6c4b8a1f21</ApplicationIdGuid>
    <!-- Has to beat the 13.1.0 already published, and a new engine on a new framework
         is not a point release. -->
    <ApplicationDisplayVersion>14.0.0</ApplicationDisplayVersion>
    <!-- Build 2: build 1 of 14.0.0 is already uploaded, and App Store Connect takes
         each version+build pair once. -->
    <ApplicationVersion>2</ApplicationVersion>

    <!-- A floor, not a target: it decides how old a device may be and nothing else,
         and this app's job is to run on whatever a prospective customer is holding.
         The engine itself needs only GLES 3.0, which iOS 13 and Android 5 both carry.

         15.0 rather than the 14.2 ThinkGeo.UI.Maui asks for because Apple stops
         accepting uploads below 15.0 in April 2027 - and because it costs nothing:
         iOS 15 runs on every device iOS 14 ran on, down to the iPhone 6s. Going
         higher would start removing devices (16 drops the 6s and the 7, 26 drops
         everything before the iPhone 11) to buy an API this app never calls. -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
    <!-- ThinkGeo.UI.Maui multi-targets a windows head, and NuGet restores every
         target framework of a referenced project even when only one is built. On a
         Mac that head has no reference assemblies, so restore stops with NETSDK1100
         unless it is told to tolerate the windows target. Nothing windows is built
         here; this only lets its restore resolve. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Mono's concurrent GC crashes Android Release builds under heavy allocation:
         https://github.com/dotnet/runtime/issues/123537 -->
    <AndroidEnableSGenConcurrent>false</AndroidEnableSGenConcurrent>
  </PropertyGroup>

  <!--
    The iOS simulator on Apple Silicon runs AOT-only (no JIT), and not every
    dependency the map pipeline pulls in - NetTopologySuite among them - has an AOT
    image that matches. The interpreter lets those fall back to interpretation
    instead of aborting the process at load. Device Release still goes through full
    AOT. This is the same opt-in PreludeMvtIos carries.
  -->
  <!--
    Signing for a device build. The simulator needs none of this, so it is scoped to
    the device runtime identifier. Automatic:AppStore asks Xcode's account for a
    matching App Store profile rather than naming a file that expires.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'ios-arm64' and '$(Configuration)' == 'Debug'">
    <CodesignKey>Apple Development: Bai YiMing (549M2A94EH)</CodesignKey>
    <CodesignProvision>Automatic</CodesignProvision>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'ios-arm64' and '$(Configuration)' == 'Release'">
    <CodesignKey>Apple Distribution: ThinkGeo LLC (LDJ2EKQRTJ)</CodesignKey>
    <CodesignProvision>Automatic:AppStore</CodesignProvision>
    <ArchiveOnBuild>true</ArchiveOnBuild>
  </PropertyGroup>

  <PropertyGroup Condition="$(RuntimeIdentifier.Contains('simulator'))">
    <UseInterpreter>true</UseInterpreter>
  </PropertyGroup>

  <ItemGroup>
    <!-- White, not the template's purple: the mark is #62B7E2 and #9E9E9C, two
         mid-tones that only read as themselves on white, and iOS draws no border
         of its own - the plate IS the icon's edge. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFFFFF" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <!--
    The privacy manifest, at the root of the bundle where the App Store looks for it.
    Without it an upload is refused with ITMS-91053, because the .NET runtime uses
    required-reason APIs whatever the linker strips.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <BundleResource Include="Platforms\iOS\PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <!--
    The sample data, shipped in the package and copied into the app's own data
    directory on first run, so every sample afterwards speaks in plain file paths
    exactly as the desktop gallery does.

    Only the files the samples actually open are here - about 40 MB of the desktop
    gallery's 169 MB. The rest belongs to samples this gallery does not have yet, or
    cannot have; adding a sample means adding its data, not shipping everything
    against the day it might be wanted.

    LogicalName keeps the path, because a flat bag of names could not tell
    Shapefile/Parks.shp from TinyGeo/Parks.tgeo. manifest.txt lists them, since an
    app package cannot be enumerated at runtime.
  -->
  <ItemGroup>
    <MauiAsset Include="Data\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Not decoration. Without a launch screen iOS runs the app in its 320x480
    compatibility box and scales the result up: every page reports 320x480
    however large the device is, so a map sizes its camera from 320x480 and
    draws that extent into a surface three times the size. The symptom is a map
    that looks stretched and whose scale is wrong, with nothing in any log.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFFFF" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\thinkgeosdk\ThinkGeo.UI\Maui\ThinkGeo.UI.Maui\ThinkGeo.UI.Maui.csproj" />

    <!-- No PostgreSQL or SQL Server provider: this gallery does not connect a phone to
         a database server, so Npgsql, Microsoft.Data.SqlClient and the MSAL broker they
         drag behind them are not in the app at all. The one database a phone genuinely
         holds is a spatial SQLite file, and SqliteFeatureSource is part of
         ThinkGeo.Core - see SampleCatalog.NotOnMobile. -->
  </ItemGroup>

  <!-- The engine is named directly, not left to arrive behind ThinkGeo.UI.Maui: the
       samples name GpuBasemap, MapStyle and the tile sources themselves. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <ProjectReference Include="..\..\thinkgeosdk\ThinkGeo.Gpu\ThinkGeo.Gpu\ThinkGeo.Gpu.csproj" />
    <ProjectReference Include="..\..\thinkgeosdk\ThinkGeo.Gpu\ThinkGeo.Gpu.iOS\ThinkGeo.Gpu.iOS.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <ProjectReference Include="..\..\thinkgeosdk\ThinkGeo.Gpu\ThinkGeo.Gpu\ThinkGeo.Gpu.csproj" />
    <ProjectReference Include="..\..\thinkgeosdk\ThinkGeo.Gpu\ThinkGeo.Gpu.Android\ThinkGeo.Gpu.Android.csproj" />
  </ItemGroup>

  <!-- Embeds ANGLE and keeps the deprecated OpenGLES.framework out of the link. -->
  <Import Project="..\..\thinkgeosdk\ThinkGeo.Gpu\ThinkGeo.Gpu.iOS\IosHead.targets"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />

</Project>
