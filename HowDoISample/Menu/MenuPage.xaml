<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:codeBehind="clr-namespace:HowDoISample"
             x:DataType="codeBehind:MenuPage"
             x:Class="HowDoISample.MenuPage"
             x:Name="MyPage"
             xmlns:local="clr-namespace:HowDoISample"
             Title="Menu">

    <StackLayout VerticalOptions="Fill" BackgroundColor="Black">
        <!-- Logo -->
        <Border BackgroundColor="Black" >
            <Image Source="thinkgeo_logo.png" MaximumWidthRequest="200" BackgroundColor="Black"/>
        </Border>

        <CollectionView x:Name="CollectionViewMenu" IsGrouped="True" SelectionMode="Single"
             ItemsSource="{Binding Source={x:Reference MyPage}, Path=CurrentSampleGroups}"
             SelectionChanged="CollectionViewMenu_SelectionChanged" BackgroundColor="Black">

            <!-- Sample Category -->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="local:GroupInfo">
                    <Grid>
                        <Label Text="{Binding Title}"
                              FontSize="Subtitle"
                              VerticalOptions="Fill"
                              TextColor="White" 
                              HorizontalOptions="Fill" BackgroundColor="Black"
                              Margin="{OnPlatform iOS={OnIdiom Default=0}, Android={OnIdiom Default=4}, Default=0}"  >
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="TextColor" Value="#61b7e1" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="False">
                                </DataTrigger>
                            </Label.Triggers>

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"
                                                          CommandParameter="{Binding .}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <!-- Sample Item -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:SampleInfo">
                    <Grid>
                        <Label Text="{Binding Title}" 
                                   Padding="30, 2, 0, 2"  BackgroundColor="Black">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="TextColor" Value="#61b7e1" />
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="TextColor"  Value="Gray" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>
