<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The MAUI how-do-I gallery. Every sample draws through GpuBasemap. The heads are
    iOS, Android and - on a Windows machine - Windows.

    It builds against the published ThinkGeo packages, so a clone of this repository
    is all it needs.
  -->

  <PropertyGroup>
    <TargetFrameworks>net10.0-ios;net10.0-android36.0</TargetFrameworks>
    <!-- Windows only where it can be built, so a Mac building the phone heads never
         restores it. Unpackaged: it runs straight from the build output, F5 or
         dotnet run, with no MSIX to deploy first. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <WindowsPackageType>None</WindowsPackageType>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>HowDoISample</RootNamespace>

    <ApplicationTitle>ThinkGeo</ApplicationTitle>
    <!-- Per platform, because MAUI's single project feeds ApplicationId to both
         CFBundleIdentifier on iOS and the package name on Android. The ThinkGeo
         licence is validated against the id, so a licence has to be issued for the
         id the platform actually uses. -->
    <ApplicationId Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">com.thinkgeo.ioshowdoi</ApplicationId>
    <ApplicationId Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">com.thinkgeo.androidhowdoi</ApplicationId>
    <ApplicationIdGuid>0d4f4f3e-7b64-4a0e-9d07-2d6c4b8a1f21</ApplicationIdGuid>
    <!-- Tracks the ThinkGeo version the gallery is built against. -->
    <ApplicationDisplayVersion>15.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>3</ApplicationVersion>

    <!-- A floor, not a target: it decides how old a device may be and nothing else.
         The engine needs OpenGL ES 3.0, which iOS 13 and Android 5 both carry. -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
    <!-- Lets restore resolve a windows target framework on a Mac, where nothing
         windows is built. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Mono's concurrent GC crashes Android Release builds under heavy allocation:
         https://github.com/dotnet/runtime/issues/123537 -->
    <AndroidEnableSGenConcurrent>false</AndroidEnableSGenConcurrent>
  </PropertyGroup>

  <!--
    The iOS simulator on Apple Silicon runs AOT-only (no JIT), and not every
    dependency of the map pipeline has an AOT image that matches. The interpreter
    lets those fall back to interpretation instead of aborting the process at load.
    A device Release build still goes through full AOT.

    No signing identity is named here. The simulator needs none, and a development
    build to a device signs with whatever development identity the machine has. A
    distribution build passes its own on the command line: -p:CodesignKey,
    -p:CodesignProvision and -p:ArchiveOnBuild=true.
  -->
  <PropertyGroup Condition="$(RuntimeIdentifier.Contains('simulator'))">
    <UseInterpreter>true</UseInterpreter>
  </PropertyGroup>

  <ItemGroup>
    <!-- A white plate: iOS draws no border of its own, so the plate is the icon's
         edge. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFFFFF" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <!--
    The privacy manifest, at the root of the bundle where the App Store looks for it.
    Without it an upload is refused with ITMS-91053, because the .NET runtime uses
    required-reason APIs whatever the linker strips.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <BundleResource Include="Platforms\iOS\PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <!--
    The sample data, shipped in the package and copied into the app's own data
    directory on first run, so the samples read plain file paths.

    LogicalName keeps the path, because a flat bag of names could not tell
    Shapefile/Parks.shp from TinyGeo/Parks.tgeo. Data/manifest.txt lists the files,
    since an app package cannot be enumerated at runtime: a file added under Data
    needs a line there.
  -->
  <ItemGroup>
    <MauiAsset Include="Data\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Required on iOS: without a launch screen the system runs the app in its 320x480
    compatibility box and scales the result up, so every page reports 320x480
    however large the device is.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFFFF" />
  </ItemGroup>

  <!-- The ThinkGeo packages, from nuget.org:

         dotnet build HowDoISample.csproj
         dotnet build HowDoISample.csproj -p:ThinkGeoPackageVersion=15.1.0-beta030

       ThinkGeoUseSource=true builds against a checkout of the SDK sources beside
       this repository instead of the packages. -->
  <PropertyGroup>
    <ThinkGeoPackageVersion Condition="'$(ThinkGeoPackageVersion)' == ''">15.1.0-beta030</ThinkGeoPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Condition="'$(ThinkGeoUseSource)' == 'true'"
                      Include="..\..\thinkgeosdk\ThinkGeo.UI\Maui\ThinkGeo.UI.Maui\ThinkGeo.UI.Maui.csproj" />
    <PackageReference Condition="'$(ThinkGeoUseSource)' != 'true'"
                      Include="ThinkGeo.UI.Maui" Version="$(ThinkGeoPackageVersion)" />
  </ItemGroup>

  <!-- The engine is named directly, not left to arrive behind ThinkGeo.UI.Maui: the
       samples name GpuBasemap, MapStyle and the tile sources themselves. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ProjectReference Condition="'$(ThinkGeoUseSource)' == 'true'"
                      Include="..\..\thinkgeosdk\ThinkGeo.Gpu\ThinkGeo.Gpu\ThinkGeo.Gpu.csproj" />
    <PackageReference Condition="'$(ThinkGeoUseSource)' != 'true'"
                      Include="ThinkGeo.Gpu" Version="$(ThinkGeoPackageVersion)" />
  </ItemGroup>

  <!-- Only for the source build: the package carries the same iOS build steps in
       its buildTransitive folder. -->
  <Import Project="..\..\thinkgeosdk\ThinkGeo.Gpu\ThinkGeo.Gpu\IosHead.targets"
          Condition="'$(ThinkGeoUseSource)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />

</Project>
