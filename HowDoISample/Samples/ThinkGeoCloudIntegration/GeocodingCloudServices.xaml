<howDoI:SamplePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:thinkgeo="clr-namespace:ThinkGeo.UI.Maui;assembly=ThinkGeo.UI.Maui"
                   xmlns:howDoI="using:HowDoISample"
                   xmlns:codeBehind="clr-namespace:HowDoISample.ThinkGeoCloudIntegration"
                   x:DataType="codeBehind:GeocodingCloudServices"
                   x:Class="HowDoISample.ThinkGeoCloudIntegration.GeocodingCloudServices">

    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <howDoI:DescriptionView Grid.Row="0"
                Description="{Binding Description, Source={x:Reference BasePage}}" />

            <thinkgeo:MapView Grid.Row="1" x:Name="mapView" 
                              VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" 
                              MapUnit="Meter" SizeChanged="Map_OnSizeChanged">
                <thinkgeo:MapView.MapTools>
                    <thinkgeo:ZoomMapTool/>
                </thinkgeo:MapView.MapTools>
            </thinkgeo:MapView>

            <HorizontalStackLayout Grid.Row="1" VerticalOptions="End" HorizontalOptions="Center"
                                   Margin="10,0,10,10" Spacing="10">
                <Entry x:Name="SearchEntry" Text="6101 Frisco Square Blvd, Frisco, TX 75034"
                       BackgroundColor="White" TextColor="Black" VerticalOptions="Center"
                       HeightRequest="40" WidthRequest="260"/>

                <Button Clicked="Search_Click" BackgroundColor="Blue" TextColor="White"
                        Text="Search" VerticalOptions="Center" HeightRequest="40"/>
            </HorizontalStackLayout>

            <ActivityIndicator
                       IsRunning="True"
                       HorizontalOptions="CenterAndExpand"
                       VerticalOptions="CenterAndExpand" Grid.Row="1" x:Name="LoadingLayout"
                       IsVisible="False"
                       AbsoluteLayout.LayoutBounds="0,0,1,1"
                       AbsoluteLayout.LayoutFlags="All"
                       BackgroundColor="White"
                       Opacity="0.5"/>

        </Grid>

    </ContentPage.Content>
</howDoI:SamplePage>
