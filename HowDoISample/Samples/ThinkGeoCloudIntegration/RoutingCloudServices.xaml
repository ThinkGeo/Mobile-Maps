<howDoI:SamplePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:thinkgeo="clr-namespace:ThinkGeo.UI.Maui;assembly=ThinkGeo.UI.Maui"
                   xmlns:howDoI="using:HowDoISample"
                   xmlns:core="clr-namespace:ThinkGeo.Core;assembly=ThinkGeo.Core"
                   xmlns:codeBehind="clr-namespace:HowDoISample.ThinkGeoCloudIntegration"
                   x:DataType="codeBehind:RoutingCloudServices"
                   x:Class="HowDoISample.ThinkGeoCloudIntegration.RoutingCloudServices">

    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <howDoI:DescriptionView Grid.Row="0"
                Description="{Binding Description, Source={x:Reference BasePage}}" />

            <thinkgeo:MapView Grid.Row="1" Grid.RowSpan="2" x:Name="mapView" 
                              SizeChanged="Map_OnSizeChanged">
                <thinkgeo:MapView.MapTools>
                    <thinkgeo:ZoomMapTool/>
                </thinkgeo:MapView.MapTools>
            </thinkgeo:MapView>

            <Grid Grid.Row="2" HeightRequest="220"  BackgroundColor="Gray" WidthRequest="360"
                  HorizontalOptions="Start" Margin="10,-20,0,0">
                <CollectionView x:Name="LsbRouteSegments" HeightRequest="220" SelectionMode="Single"
                                  SelectionChanged="lsbRouteSegments_SelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="core:CloudRoutingSegment">
                            <Grid Padding="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0"
                                    Text="{Binding Instruction}"/>

                                <Label Grid.Row="1"
                                    Text="{Binding Distance, StringFormat='Distance: {0:0.00} meters'}"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
        </Grid>

    </ContentPage.Content>
</howDoI:SamplePage>
