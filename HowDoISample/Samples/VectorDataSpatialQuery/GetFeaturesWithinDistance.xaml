<howDoI:SamplePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:thinkgeo="clr-namespace:ThinkGeo.UI.Maui;assembly=ThinkGeo.UI.Maui"
                   xmlns:howDoI="using:HowDoISample"
                   xmlns:codeBehind="clr-namespace:HowDoISample.VectorDataSpatialQuery"
                   x:DataType="codeBehind:GetFeaturesWithinDistance"
                   x:Class="HowDoISample.VectorDataSpatialQuery.GetFeaturesWithinDistance">

    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <howDoI:DescriptionView Grid.Row="0"
                    Description="{Binding Description, Source={x:Reference BasePage}}" />

            <thinkgeo:MapView Grid.Row="1" x:Name="mapView" SingleTap="mapView_SingleTap"
                              SizeChanged="GetFeaturesWithinDistance_OnSizeChanged">

                <thinkgeo:MapView.MapTools>
                    <thinkgeo:ZoomMapTool/>
                </thinkgeo:MapView.MapTools>
            </thinkgeo:MapView>

            <Grid Grid.Row="1" ZIndex="10" Margin="10,0,10,20" VerticalOptions="End" BackgroundColor="#80777777">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Slider x:Name="SearchRadius" Grid.Column="0" Maximum="1600" Minimum="100" Value="400" VerticalOptions="Center"/>
                <Label Grid.Column="1" x:DataType="Slider" TextColor="Black" Margin="20,0,20,0" 
                       HorizontalOptions="Center" VerticalOptions="Center" LineBreakMode="NoWrap"
                       Text="{Binding Path=Value, Source={x:Reference SearchRadius}, StringFormat='{0:F0} m'}"/>
            </Grid>

        </Grid>
    </ContentPage.Content>
</howDoI:SamplePage>
